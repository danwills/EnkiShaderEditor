---
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src={`${base}media/app-icon.svg`} alt="Enki Shader Editor" class="footer-icon" width="28" height="28" />
      <span class="footer-name">Enki Shader Editor</span>
    </div>

    <div class="footer-links">
      <a href="https://github.com/danwills/EnkiShaderEditor" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://github.com/danwills/EnkiShaderEditor/issues" target="_blank" rel="noopener noreferrer">Issues</a>
      <a href="https://github.com/danwills/EnkiShaderEditor/blob/master/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">Contributing</a>
      <a href="https://github.com/danwills/EnkiShaderEditor/blob/master/PRIVACY.md" target="_blank" rel="noopener noreferrer">Privacy</a>
    </div>

    <p class="footer-copy">
      Enki Shader Editor is maintained by <a href="https://github.com/danwills" target="_blank" rel="noopener noreferrer">Dan Wills</a>,
      forked from <a href="https://github.com/markusfisch/ShaderEditor" target="_blank" rel="noopener noreferrer">ShaderEditor</a>
      by <a href="https://github.com/markusfisch" target="_blank" rel="noopener noreferrer">Markus Fisch</a>.
      Open source under MIT.
      Made with help from <a href="https://claude.ai" target="_blank" rel="noopener noreferrer">Claude</a>.
    </p>

    <div class="footer-original">
      <p class="footer-original-label">
        <span class="footer-original-tag">Psst, not Enki!</span>
        These go to Markus' original ShaderEditor:
      </p>
      <div class="footer-original-badges">
        <a href="https://f-droid.org/en/packages/de.markusfisch.android.shadereditor/" target="_blank" rel="noopener noreferrer">
          <img src={`${base}media/badge-fdroid.svg`} alt="Markus Fisch's ShaderEditor on F-Droid" />
        </a>
        <a href="https://play.google.com/store/apps/details?id=de.markusfisch.android.shadereditor" target="_blank" rel="noopener noreferrer">
          <img src={`${base}media/badge-google-play.svg`} alt="Markus Fisch's ShaderEditor on Google Play" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding: 3rem 0;
    text-align: center;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-icon {
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.3);
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--accent-cyan);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-copy a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: rgba(255,255,255,0.15);
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .footer-copy a:hover {
    color: var(--accent-cyan);
  }

  .footer-original {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-original-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer-original-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent-magenta);
    border: 1px solid var(--accent-magenta);
    border-radius: var(--radius-xl);
    padding: 0.1rem 0.55rem;
    margin-right: 0.35rem;
    transform: rotate(-3deg);
  }

  .footer-original-badges {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-original-badges img {
    height: 28px;
    width: auto;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .footer-original-badges a:hover img {
    opacity: 1;
  }
</style>
