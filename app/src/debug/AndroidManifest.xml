<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the test tooling show a toast on the phone -
     see TestStatusToastReceiver and tools/phone/status.sh. Exported with no
     permission on purpose: adb's shell has to reach it, and all it can do is
     show a toast. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">
	<application>
		<receiver
			android:name=".receiver.TestStatusToastReceiver"
			android:exported="true"
			tools:ignore="ExportedReceiver"/>
	</application>
</manifest>
