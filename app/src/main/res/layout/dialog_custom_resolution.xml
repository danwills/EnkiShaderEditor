<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<!-- Up here (not grouped with Cancel's old spot down at the
		     bottom) so confirming doesn't need a scroll through every
		     option below first - see showCustomResolutionDialog()'s own
		     comment on why these are plain custom buttons, not
		     AlertDialog's built-in slots. Cancel to the left, Start
		     Render to the right (brighter/accent-colored - see
		     toggle_active - so it reads as the one actually-committing
		     action in the row) mirrors how the two read left-to-right
		     either way. -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<Button
				android:id="@+id/custom_res_cancel"
				style="@style/BarButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@android:string/cancel" />

			<Button
				android:id="@+id/custom_res_ok"
				style="@style/BarButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:gravity="end|center_vertical"
				android:textColor="@color/toggle_active"
				android:text="@string/start_render" />

		</LinearLayout>

		<!-- Long-press for the full explanation (see
		     higher_res_match_device_playback). -->
		<CheckBox
			android:id="@+id/custom_match_device_playback"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:checked="false"
			android:text="@string/higher_res_match_device_playback_label" />

		<!-- Only while Match App Res Setting is on: the capture comes out
		     as the screen shows it, through the upscaling, at the view's
		     size - Video Scale 1. See ShaderRenderer.setCaptureUpscaled(). -->
		<CheckBox
			android:id="@+id/custom_include_upscaling"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="24dp"
			android:checked="false"
			android:text="@string/higher_res_include_upscaling_label" />

		<!-- Only affects what picking one of the "x Device Res" presets
		     does - see MainActivity's own wiring; never touches
		     anything for "Resolution" (the no-op placeholder) or a
		     fixed pixel-size preset. Disabled as a whole (not just the
		     fields below it) while custom_match_device_playback above
		     is checked - see updateMatchAppResEnablement. -->
		<Spinner
			android:id="@+id/custom_res_preset"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:entries="@array/custom_res_presets" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<EditText
				android:id="@+id/custom_width"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:hint="@string/higher_res_custom_width"
				android:inputType="number"
				android:maxLength="5" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginHorizontal="12dp"
				android:text="×" />

			<EditText
				android:id="@+id/custom_height"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:hint="@string/higher_res_custom_height"
				android:inputType="number"
				android:maxLength="5" />

		</LinearLayout>

		<!-- A persistent label, not just the EditText's own hint - same
		     issue as custom_oversample below. Moved up here, next to the
		     resolution fields it's closely related to (see
		     custom_match_device_playback above), rather than buried
		     under "Render a Sequence of Frames" -> "Create Video from
		     Frames" - it only ever does anything when a video actually
		     gets made, but editing it doesn't depend on either being
		     checked. Long-press for the full explanation (see
		     higher_res_sequence_video_scale). -->
		<TextView
			android:id="@+id/sequence_video_scale_label"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/higher_res_sequence_video_scale_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<EditText
			android:id="@+id/sequence_video_scale"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="number"
			android:maxLength="4"
			android:text="1" />

		<!-- A persistent label, not just the EditText's own hint - the
		     hint never actually shows since the field always starts
		     pre-filled with "1", not blank (same issue as
		     sequence_skip_frames below). Long-press for the full
		     explanation (see higher_res_oversample). -->
		<TextView
			android:id="@+id/custom_oversample_label"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/higher_res_oversample_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<EditText
			android:id="@+id/custom_oversample"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="number"
			android:maxLength="3"
			android:text="1" />

		<!-- Purely cosmetic - see TileRenderOrder's own doc - but a fun
		     one to tweak before starting a capture, and (for a
		     frame-sequence capture) also live-changeable from the
		     progress dialog's own copy of this same Spinner. -->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/higher_res_tile_order"
			android:textAppearance="?attr/textAppearanceCaption" />

		<Spinner
			android:id="@+id/custom_tile_order"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:entries="@array/tile_order_names" />

		<!-- How big each tile ("bucket") is - see TileBucketSize's own
		     doc. Max, combined with 1x oversampling above, skips tiling
		     entirely for a resolution that still fits in one texture -
		     faster for a cheap/fast shader, but risky for an expensive
		     one (see the same doc for why). -->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/higher_res_bucket_size"
			android:textAppearance="?attr/textAppearanceCaption" />

		<Spinner
			android:id="@+id/custom_bucket_size"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:entries="@array/bucket_size_names" />

		<!-- Long-press for the full explanation (see
		     higher_res_auto_detect_tile_size). When checked, the bucket
		     size spinner above is overridden - not hidden, so its last
		     setting stays visible/remembered for next time - and Render
		     first spends some up-front time testing progressively larger
		     tile sizes in an isolated disposable process (see
		     TileSizeProber) before continuing straight into the real
		     capture at whatever came out safe. -->
		<CheckBox
			android:id="@+id/custom_auto_detect_tile_size"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/higher_res_auto_detect_tile_size_label" />

		<!-- Long-press for the full explanation (see
		     higher_res_preserve_backbuffer). -->
		<CheckBox
			android:id="@+id/preserve_backbuffer_edges"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:checked="true"
			android:text="@string/higher_res_preserve_backbuffer_label" />

		<!-- Long-press for the full explanation (see
		     higher_res_restart_shader). -->
		<CheckBox
			android:id="@+id/restart_shader"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:checked="false"
			android:text="@string/higher_res_restart_shader_label" />

		<CheckBox
			android:id="@+id/render_sequence"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:checked="false"
			android:text="@string/higher_res_render_sequence" />

		<LinearLayout
			android:id="@+id/sequence_options"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<EditText
					android:id="@+id/sequence_frame_count"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:hint="@string/higher_res_sequence_frame_count"
					android:inputType="number"
					android:maxLength="6"
					android:text="30" />

				<EditText
					android:id="@+id/sequence_fps"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="12dp"
					android:hint="@string/higher_res_sequence_fps"
					android:inputType="numberDecimal"
					android:maxLength="6"
					android:text="30" />

			</LinearLayout>

			<TextView
				android:id="@+id/sequence_duration"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:textAppearance="?attr/textAppearanceCaption" />

			<!-- A persistent label, not just the EditText's own hint -
			     the hint never actually shows since the field always
			     starts pre-filled with "0", not blank. -->
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/higher_res_sequence_skip_frames"
				android:textAppearance="?attr/textAppearanceCaption" />

			<EditText
				android:id="@+id/sequence_skip_frames"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="number"
				android:maxLength="6"
				android:text="0" />

			<CheckBox
				android:id="@+id/sequence_create_video"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:checked="true"
				android:text="@string/higher_res_sequence_create_video" />

			<LinearLayout
				android:id="@+id/sequence_video_options"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="32dp"
				android:orientation="vertical">

				<TextView
					android:id="@+id/sequence_video_quality_label"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:textAppearance="?attr/textAppearanceCaption" />

				<SeekBar
					android:id="@+id/sequence_video_quality"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:max="100" />

				<CheckBox
					android:id="@+id/sequence_cleanup_images"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:checked="true"
					android:text="@string/higher_res_sequence_cleanup" />

			</LinearLayout>

		</LinearLayout>

	</LinearLayout>
</ScrollView>
