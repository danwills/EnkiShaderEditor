<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">
		<TextView
			android:id="@+id/adjust_defines_confirm_summary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFamily="monospace"
			android:padding="16dp"
			android:textIsSelectable="true"
			android:textSize="14sp"/>
	</ScrollView>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/colorSurfaceVariant"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:padding="12dp">
		<ImageView
			android:layout_width="20dp"
			android:layout_height="20dp"
			android:layout_marginEnd="8dp"
			android:contentDescription="@null"
			android:src="@drawable/ic_warning"
			app:tint="@color/toggle_active"/>
		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/adjust_defines_save_permanent_warning"
			android:textSize="12sp"/>
	</LinearLayout>

	<!-- The changes as a new shader named after this one (with a
	     postfix), this one left as it was - see
	     MainActivity.showAdjustDefinesConfirmDialog(). -->
	<Button
		android:id="@+id/adjust_defines_confirm_save_as_new"
		style="@style/BarButton"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="8dp"
		android:layout_marginTop="8dp"
		android:text="@string/duplicate_shader"/>

	<!-- Custom row (not AlertDialog's own 3-button slots) so the order
	     reads left-to-right exactly as asked for: Apply, Apply and
	     Save, Cancel - see showCustomResolutionDialog()'s own comment
	     for why this project prefers that over the built-in slots
	     whenever more than two actions are needed. -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:padding="8dp">
		<Button
			android:id="@+id/adjust_defines_confirm_apply"
			style="@style/BarButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/adjust_defines_apply"/>
		<Button
			android:id="@+id/adjust_defines_confirm_apply_and_save"
			style="@style/BarButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/adjust_defines_apply_and_save"
			android:textColor="@color/toggle_active"/>
		<Button
			android:id="@+id/adjust_defines_confirm_cancel"
			style="@style/BarButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@android:string/cancel"/>
	</LinearLayout>
</LinearLayout>
