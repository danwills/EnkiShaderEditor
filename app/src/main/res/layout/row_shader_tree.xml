<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="start|center_vertical"
	android:orientation="horizontal"
	android:paddingVertical="12dp"
	android:paddingEnd="16dp"
	android:background="@drawable/drawer_item_selector">

	<ImageView
		android:id="@+id/tree_chevron"
		android:layout_width="32dp"
		android:layout_height="32dp"
		android:padding="4dp"
		android:contentDescription="@string/expand_collapse"
		android:src="@drawable/ic_next"/>

	<ImageView
		android:id="@+id/shader_icon"
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="16dp"
		android:contentDescription="@string/shader"/>

	<TextView
		android:id="@+id/shader_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textSize="14sp"
		android:lines="1"
		android:ellipsize="end"/>
</LinearLayout>
