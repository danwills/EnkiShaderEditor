<?xml version="1.0" encoding="utf-8"?>
<!-- See ShaderPackBuilderDialog. The whole form scrolls, and so does the
	shader checklist inside it (a fixed height, so it always shows a good
	few rows however tall the fields above it are). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

<LinearLayout
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="20dp"
	android:paddingTop="8dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_title_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/pack_title_hint"
		android:importantForAutofill="no"
		android:inputType="textCapWords"
		android:maxLines="1" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingTop="10dp">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/pack_id_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<TextView
			android:layout_width="96dp"
			android:layout_height="wrap_content"
			android:text="@string/pack_version_label"
			android:textAppearance="?attr/textAppearanceCaption" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<EditText
			android:id="@+id/pack_id"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:hint="@string/pack_id_hint"
			android:importantForAutofill="no"
			android:inputType="text"
			android:maxLines="1" />

		<EditText
			android:id="@+id/pack_version"
			android:layout_width="96dp"
			android:layout_height="wrap_content"
			android:hint="@string/pack_version_hint"
			android:importantForAutofill="no"
			android:inputType="number"
			android:maxLines="1" />
	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_author_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_author"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/pack_author_hint"
		android:importantForAutofill="no"
		android:inputType="textPersonName"
		android:maxLines="1" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_description_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_description"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="top"
		android:hint="@string/pack_description_hint"
		android:importantForAutofill="no"
		android:inputType="textMultiLine|textCapSentences"
		android:maxLines="6"
		android:minLines="2" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_shaders_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_filter"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/pack_filter_hint"
		android:importantForAutofill="no"
		android:inputType="text"
		android:maxLines="1" />

	<TextView
		android:id="@+id/pack_selected_count"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="8dp"
		android:textAppearance="?attr/textAppearanceCaption" />

	<ListView
		android:id="@+id/pack_shaders"
		android:layout_width="match_parent"
		android:layout_height="300dp"
		android:nestedScrollingEnabled="true" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>
