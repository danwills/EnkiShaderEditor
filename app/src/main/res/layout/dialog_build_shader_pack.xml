<?xml version="1.0" encoding="utf-8"?>
<!-- See ShaderPackBuilderDialog. The whole form scrolls, and so does the
	shader checklist inside it (a fixed height, so it always shows a good
	few rows however tall the fields above it are). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

<LinearLayout
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="20dp"
	android:paddingTop="8dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_title_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/pack_title_hint"
		android:importantForAutofill="no"
		android:inputType="textCapWords"
		android:maxLines="1" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingTop="10dp">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/pack_id_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<TextView
			android:layout_width="96dp"
			android:layout_height="wrap_content"
			android:text="@string/pack_version_label"
			android:textAppearance="?attr/textAppearanceCaption" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<EditText
			android:id="@+id/pack_id"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:hint="@string/pack_id_hint"
			android:importantForAutofill="no"
			android:inputType="text"
			android:maxLines="1" />

		<EditText
			android:id="@+id/pack_version"
			android:layout_width="96dp"
			android:layout_height="wrap_content"
			android:hint="@string/pack_version_hint"
			android:importantForAutofill="no"
			android:inputType="number"
			android:maxLines="1" />
	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_author_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_author"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/pack_author_hint"
		android:importantForAutofill="no"
		android:inputType="textPersonName"
		android:maxLines="1" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_description_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_description"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="top"
		android:hint="@string/pack_description_hint"
		android:importantForAutofill="no"
		android:inputType="textMultiLine|textCapSentences"
		android:maxLines="6"
		android:minLines="2" />

	<CheckBox
		android:id="@+id/pack_show"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:text="@string/pack_present_as_show" />

	<!-- See ShaderPackBuilderDialog and PackShow: only while pack_show is
		ticked. -->
	<LinearLayout
		android:id="@+id/pack_show_options"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:visibility="gone">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/pack_show_seconds_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<EditText
			android:id="@+id/pack_show_seconds"
			android:layout_width="96dp"
			android:layout_height="wrap_content"
			android:importantForAutofill="no"
			android:inputType="number"
			android:maxLines="1"
			tools:ignore="LabelFor" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="10dp"
			android:text="@string/pack_show_soundtrack_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<Spinner
			android:id="@+id/pack_show_soundtrack"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="10dp"
			android:text="@string/pack_show_quality_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<Spinner
			android:id="@+id/pack_show_quality"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="10dp"
			android:text="@string/pack_show_timeline_label"
			android:textAppearance="?attr/textAppearanceCaption" />

		<EditText
			android:id="@+id/pack_show_timeline"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFamily="monospace"
			android:gravity="top"
			android:hint="@string/pack_show_timeline_hint"
			android:importantForAutofill="no"
			android:inputType="textMultiLine|textNoSuggestions"
			android:maxLines="8"
			android:minLines="2"
			android:textSize="12sp" />
	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="10dp"
		android:text="@string/pack_shaders_label"
		android:textAppearance="?attr/textAppearanceCaption" />

	<EditText
		android:id="@+id/pack_filter"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/pack_filter_hint"
		android:importantForAutofill="no"
		android:inputType="text"
		android:maxLines="1" />

	<CheckBox
		android:id="@+id/pack_similar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/pack_similar_to_ticked" />

	<TextView
		android:id="@+id/pack_similar_threshold_label"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textAppearance="?attr/textAppearanceCaption"
		android:visibility="gone" />

	<SeekBar
		android:id="@+id/pack_similar_threshold"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:max="90"
		android:visibility="gone" />

	<TextView
		android:id="@+id/pack_selected_count"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="8dp"
		android:textAppearance="?attr/textAppearanceCaption" />

	<ListView
		android:id="@+id/pack_shaders"
		android:layout_width="match_parent"
		android:layout_height="300dp"
		android:nestedScrollingEnabled="true" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>
