<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="16dp">
	<EditText
		tools:targetApi="o"
		style="@android:style/Widget.EditText"
		android:id="@+id/query"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/find_shader"
		android:imeOptions="actionSearch"
		android:inputType="text"
		android:importantForAutofill="no"/>
	<CheckBox
		android:id="@+id/search_source"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/search_shader_source"/>
	<CheckBox
		android:id="@+id/fuzzy_matching"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/fuzzy_matching"/>

	<!-- Live total, updated as the query/options change - shown only
	     before a specific match has been picked, since result_row's own
	     result_position below covers "x of y" once one has. -->
	<TextView
		android:id="@+id/match_count"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:gravity="center"
		android:textSize="13sp"
		android:alpha="0.7"
		android:visibility="gone"/>

	<LinearLayout
		android:id="@+id/result_row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:visibility="gone">
		<ImageView
			android:id="@+id/result_icon"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_marginEnd="16dp"
			android:contentDescription="@string/shader"/>
		<TextView
			android:id="@+id/result_title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textSize="16sp"
			android:lines="1"
			android:ellipsize="end"/>
		<TextView
			android:id="@+id/result_position"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:textSize="13sp"
			android:alpha="0.7"/>
		<Button
			android:id="@+id/result_load"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/load"/>
	</LinearLayout>

	<LinearLayout
		android:id="@+id/find_nav_row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center"
		android:visibility="gone">
		<Button
			android:id="@+id/find_previous"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:contentDescription="@string/find_previous"
			app:icon="@drawable/ic_previous"
			app:iconSize="24dp"/>
		<Button
			android:id="@+id/find_random"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginStart="12dp"
			android:contentDescription="@string/find_random"
			app:icon="@drawable/ic_dice"
			app:iconSize="24dp"/>
		<Button
			android:id="@+id/find_next_match"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginStart="12dp"
			android:contentDescription="@string/find_next"
			app:icon="@drawable/ic_next"
			app:iconSize="24dp"/>
	</LinearLayout>
</LinearLayout>
