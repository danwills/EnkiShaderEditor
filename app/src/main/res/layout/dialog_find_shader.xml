<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="16dp">
	<EditText
		tools:targetApi="o"
		style="@android:style/Widget.EditText"
		android:id="@+id/query"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/find_shader"
		android:imeOptions="actionSearch"
		android:inputType="text"
		android:importantForAutofill="no"/>
	<CheckBox
		android:id="@+id/search_source"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/search_shader_source"/>
	<CheckBox
		android:id="@+id/fuzzy_matching"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/fuzzy_matching"/>

	<LinearLayout
		android:id="@+id/result_row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:visibility="gone">
		<ImageView
			android:id="@+id/result_icon"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_marginEnd="16dp"
			android:contentDescription="@string/shader"/>
		<TextView
			android:id="@+id/result_title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textSize="16sp"
			android:lines="1"
			android:ellipsize="end"/>
		<Button
			android:id="@+id/result_load"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/load"/>
	</LinearLayout>
</LinearLayout>
