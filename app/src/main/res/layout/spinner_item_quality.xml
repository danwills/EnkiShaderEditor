<!-- A tight-fitting stand-in for android.R.layout.simple_spinner_item,
     used only for the quality spinner's closed (trigger) state. The
     stock layout's built-in min-width (platform touch-target sizing)
     made the spinner reserve ~140dp of mostly-empty space once it sat
     mid-flow in the toolbar's FlowLayout. No minimum width is needed
     to keep it steady: a wrap_content Spinner already measures every
     item and takes the widest ("1/32"), whichever is showing - see
     ShaderViewManager.initQualitySpinner(), which blanks Upscaling…
     so that word doesn't set the width. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@android:id/text1"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:minWidth="0dp"
	android:minHeight="0dp"
	android:paddingStart="0dp"
	android:paddingEnd="0dp"
	android:gravity="center"
	android:singleLine="true"
	android:textColor="@color/drawer_text"
	android:textSize="14sp" />
