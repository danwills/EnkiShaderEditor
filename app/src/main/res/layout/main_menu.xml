<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:layout_gravity="end"
	android:background="@drawable/background_menu">

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<LinearLayout
			android:layout_width="@dimen/menu_width"
			android:layout_height="wrap_content"
			android:background="@drawable/background_menu_header"
			android:orientation="horizontal">

			<Button
				android:id="@+id/undo"
				style="@style/MenuItem"
				android:layout_width="0dp"
				android:layout_height="@dimen/menu_item_height"
				android:layout_weight="1"
				android:contentDescription="@string/undo"
				android:gravity="center"
				app:icon="@drawable/ic_undo"
				app:iconGravity="textStart"
				app:iconPadding="0dp" />

			<Button
				android:id="@+id/redo"
				style="@style/MenuItem"
				android:layout_width="0dp"
				android:layout_height="@dimen/menu_item_height"
				android:layout_weight="1"
				android:contentDescription="@string/redo"
				android:gravity="center"
				app:icon="@drawable/ic_redo"
				app:iconGravity="textStart"
				app:iconPadding="0dp" />
		</LinearLayout>

		<Button
			android:id="@+id/add_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/add_shader"
			app:icon="@drawable/ic_add" />

		<Button
			android:id="@+id/paste_as_new_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/paste_as_new_shader"
			app:icon="@drawable/ic_content_paste" />

		<Button
			android:id="@+id/save_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/save_shader"
			app:icon="@drawable/ic_save" />

		<Button
			android:id="@+id/duplicate_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/duplicate_shader"
			app:icon="@drawable/ic_file_copy" />

		<Button
			android:id="@+id/delete_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:gravity="center|start"
			android:text="@string/delete_shader"
			app:icon="@drawable/ic_delete_forever" />

		<com.google.android.material.divider.MaterialDivider
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginVertical="4dp"
			app:dividerInsetEnd="8dp"
			app:dividerInsetStart="8dp" />

		<Button
			android:id="@+id/share_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:gravity="center|start"
			android:text="@string/share_shader"
			app:icon="@drawable/ic_share" />

		<Button
			android:id="@+id/copy_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:gravity="center|start"
			android:text="@string/copy_shader"
			app:icon="@drawable/ic_content_copy" />

		<Button
			android:id="@+id/pause_shader"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/pause_shader"
			app:icon="@drawable/ic_pause" />

		<com.google.android.material.divider.MaterialDivider
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginVertical="4dp"
			app:dividerInsetEnd="8dp"
			app:dividerInsetStart="8dp" />

		<Button
			android:id="@+id/settings"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/settings"
			app:icon="@drawable/ic_settings" />

		<Button
			android:id="@+id/hide_toolbar"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/hide_toolbar"
			app:icon="@drawable/ic_bottom_panel_close" />

		<Button
			android:id="@+id/shader_stats"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/shader_stats"
			app:icon="@drawable/ic_stats" />

		<com.google.android.material.divider.MaterialDivider
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginVertical="4dp"
			app:dividerInsetEnd="8dp"
			app:dividerInsetStart="8dp" />

		<Button
			android:id="@+id/more_options"
			style="@style/MenuItem"
			android:layout_width="match_parent"
			android:layout_height="@dimen/menu_item_height"
			android:text="@string/more_options"
			app:icon="@drawable/ic_next" />

		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:hintEnabled="false" />

	</LinearLayout>
</ScrollView>