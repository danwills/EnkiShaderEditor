<merge xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- ShaderView as the background -->
	<enk.danwills.android.enkishadereditor.widget.ShaderView
		android:id="@+id/preview"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<!-- CoordinatorLayout for managing the toolbar, drawer, and content -->
	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/main_coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<!-- LinearLayout to manage vertical space -->
		<LinearLayout
			android:id="@+id/main_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">

			<include layout="@layout/toolbar_main" />

			<!-- DrawerLayout with main content -->
			<enk.danwills.android.enkishadereditor.widget.TouchThruDrawerLayout
				android:id="@+id/drawer_layout"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1">

				<!-- Content Frame -->
				<androidx.coordinatorlayout.widget.CoordinatorLayout
					android:id="@+id/content_frame"
					android:layout_width="match_parent"
					android:layout_height="match_parent">

				</androidx.coordinatorlayout.widget.CoordinatorLayout>

				<!-- Navigation Drawer -->
				<include layout="@layout/drawer" />

			</enk.danwills.android.enkishadereditor.widget.TouchThruDrawerLayout>

			<!-- Extra keys row at the bottom -->
			<include
				layout="@layout/extra_keys"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />

		</LinearLayout>

		<!-- Nav bar background for SDK35+ -->
		<include layout="@layout/navbar"/>

		<!-- Persistent label below the toolbar: the current shader's
		     name, or its date if unnamed. Plain when the code editor is
		     hidden (the shader preview is behind it); given a darkened
		     background by UIManager when the editor is showing, so it
		     stays readable over code text. -->
		<TextView
			android:id="@+id/shader_title_label"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|center_horizontal"
			android:gravity="center"
			android:paddingHorizontal="12dp"
			android:paddingVertical="4dp"
			android:textColor="@color/drawer_text"
			android:textSize="14sp"
			android:maxLines="1"
			android:ellipsize="end"
			android:elevation="8dp"/>

		<!-- Transient overlay naming the shader after prev/next/random -->
		<TextView
			android:id="@+id/shader_name_overlay"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:background="@drawable/background_menu"
			android:paddingHorizontal="24dp"
			android:paddingVertical="12dp"
			android:textColor="@color/drawer_text"
			android:textSize="20sp"
			android:elevation="8dp"
			android:visibility="gone"
			android:alpha="0"/>

		<!-- Fullscreen-exit gesture's "release to exit" cue -->
		<TextView
			android:id="@+id/fullscreen_exit_hint"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom|center_horizontal"
			android:layout_marginBottom="64dp"
			android:background="@drawable/background_menu"
			android:paddingHorizontal="16dp"
			android:paddingVertical="8dp"
			android:text="@string/release_to_exit_fullscreen"
			android:textColor="@color/drawer_text"
			android:textSize="13sp"
			android:elevation="8dp"
			android:visibility="gone"
			android:alpha="0"/>

	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</merge>
