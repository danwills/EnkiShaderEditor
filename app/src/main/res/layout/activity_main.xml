<merge xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- ShaderView as the background -->
	<enk.danwills.android.enkishadereditor.widget.ShaderView
		android:id="@+id/preview"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<!-- CoordinatorLayout for managing the toolbar, drawer, and content -->
	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/main_coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<!-- LinearLayout to manage vertical space -->
		<LinearLayout
			android:id="@+id/main_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">

			<include layout="@layout/toolbar_main" />

			<!-- DrawerLayout with main content -->
			<enk.danwills.android.enkishadereditor.widget.TouchThruDrawerLayout
				android:id="@+id/drawer_layout"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1">

				<!-- Content Frame -->
				<androidx.coordinatorlayout.widget.CoordinatorLayout
					android:id="@+id/content_frame"
					android:layout_width="match_parent"
					android:layout_height="match_parent">

				</androidx.coordinatorlayout.widget.CoordinatorLayout>

				<!-- Navigation Drawer -->
				<include layout="@layout/drawer" />

			</enk.danwills.android.enkishadereditor.widget.TouchThruDrawerLayout>

			<!-- Extra keys row at the bottom -->
			<include
				layout="@layout/extra_keys"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />

		</LinearLayout>

		<!-- Nav bar background for SDK35+ -->
		<include layout="@layout/navbar"/>

		<!-- Persistent row below the toolbar: the current shader's name
		     (or its date if unnamed), with the live fps reading just
		     after it - moved here from the icon toolbar, where it was a
		     wide, unclickable passenger squeezed in among buttons that
		     actually do something when tapped. Full-width so a long
		     name still wraps instead of being clipped. Plain when the
		     code editor is hidden (the shader preview is behind it);
		     given a darkened, edge-to-edge background by UIManager when
		     the editor is showing, so it stays readable over code - the
		     editor's own top margin is then pushed down by exactly this
		     row's height (see UIManager/EditorFragment), so the two
		     never overlap. -->
		<LinearLayout
			android:id="@+id/shader_title_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="top"
			android:orientation="vertical"
			android:gravity="center"
			android:paddingHorizontal="16dp"
			android:paddingVertical="8dp"
			android:elevation="8dp">

			<enk.danwills.android.enkishadereditor.widget.OutlinedTextView
				android:id="@+id/shader_title_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:textColor="@color/drawer_text"
				android:textSize="22sp"/>

			<enk.danwills.android.enkishadereditor.widget.OutlinedTextView
				android:id="@+id/fps_label"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:textColor="@color/drawer_text"
				android:textSize="15sp"/>

			<!-- The name and fps above are outlined (OutlinedTextView) so they
			     stay readable over a bright shader.
			     Shown only while the live preview renders progressively:
			     a dot that shrinks as the current frame nears completion
			     and is absent while a finished frame is shown (see
			     ProgressiveSpinnerView). -->
			<enk.danwills.android.enkishadereditor.widget.ProgressiveSpinnerView
				android:id="@+id/progressive_spinner"
				android:layout_width="14dp"
				android:layout_height="14dp"
				android:layout_marginTop="4dp"
				android:visibility="gone"/>

		</LinearLayout>

		<!-- Transient "found it" ring drawn around a Find-in-Shader match -
		     positioned, sized and animated at runtime from the matched
		     text's on-screen bounds, see UIManager.flashSearchMatch(). -->
		<View
			android:id="@+id/search_match_indicator"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:background="@drawable/search_match_ring"
			android:visibility="gone"
			android:elevation="8dp"/>

		<!-- Transient overlay naming the shader after prev/next/random -->
		<TextView
			android:id="@+id/shader_name_overlay"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:background="@drawable/background_menu"
			android:paddingHorizontal="24dp"
			android:paddingVertical="12dp"
			android:textColor="@color/drawer_text"
			android:textSize="20sp"
			android:elevation="8dp"
			android:visibility="gone"
			android:alpha="0"/>

		<!-- Shown while returning to the app with the live render not
		     yet back on screen - see MainActivity's
		     onResumeRenderPending(). Only appears if that takes longer
		     than a moment, so a fast shader never flashes it. -->
		<ProgressBar
			android:id="@+id/resume_render_indicator"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="center"
			android:indeterminate="true"
			android:elevation="8dp"
			android:visibility="gone"/>

		<!-- Fullscreen-exit gesture's "release to exit" cue -->
		<TextView
			android:id="@+id/fullscreen_exit_hint"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom|center_horizontal"
			android:layout_marginBottom="64dp"
			android:background="@drawable/background_menu"
			android:paddingHorizontal="16dp"
			android:paddingVertical="8dp"
			android:text="@string/release_to_exit_fullscreen"
			android:textColor="@color/drawer_text"
			android:textSize="13sp"
			android:elevation="8dp"
			android:visibility="gone"
			android:alpha="0"/>

	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</merge>
