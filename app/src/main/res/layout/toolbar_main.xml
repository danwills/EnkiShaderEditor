<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/toolbar_container"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<!-- The drawer toggle, fps label, and every toolbar action button
	     plus the quality spinner, as a single left-justified flow: it
	     wraps to however many rows it needs instead of a fixed row
	     count, so landscape (or a smaller icon size) settles into fewer
	     rows automatically. -->
	<enk.danwills.android.enkishadereditor.widget.FlowLayout
		android:id="@+id/action_buttons_row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/primary_translucent"
		android:paddingStart="4dp"
		android:paddingTop="4dp"
		android:paddingBottom="4dp">

		<Button
			android:id="@+id/drawer_toggle_btn"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			app:icon="@drawable/ic_menu"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/menu_btn"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			app:icon="@drawable/ic_more_vert"
			app:iconSize="24dp" />

		<TextView
			android:id="@+id/fps_label"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:gravity="center_vertical"
			android:textAppearance="@style/Subtitle"
			android:textColor="@color/drawer_text" />

		<Button
			android:id="@+id/toggle_code"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			app:icon="@drawable/ic_edit"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/run_code"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			app:icon="@drawable/ic_play_arrow"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/show_errors"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			app:icon="@drawable/ic_error"
			app:iconSize="24dp" />

		<!-- wrap_content is safe here (see spinner_item_quality.xml): the
		     stock simple_spinner_item layout this used to use carries a
		     platform touch-target min-width that reserved ~140dp of
		     mostly-empty space once this sat mid-flow instead of alone
		     at the end of a full-width toolbar row. -->
		<Spinner
			android:id="@+id/quality"
			android:layout_width="wrap_content"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp" />

		<Button
			android:id="@+id/previous_shader"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/previous_shader"
			app:icon="@drawable/ic_previous"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/next_shader"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/next_shader"
			app:icon="@drawable/ic_next"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/random_shader"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/random_shader"
			app:icon="@drawable/ic_dice"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/restart_shader_nav"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/restart_shader"
			app:icon="@drawable/ic_restart"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/pause_shader_nav"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/pause_shader"
			app:icon="@drawable/ic_pause"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/fullscreen_nav"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/fullscreen"
			app:icon="@drawable/ic_fullscreen"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/undo_nav"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/undo"
			app:icon="@drawable/ic_undo"
			app:iconSize="24dp" />

		<Button
			android:id="@+id/reacquire_audio"
			style="@style/IconButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginEnd="4dp"
			android:layout_marginBottom="4dp"
			android:contentDescription="@string/reacquire_audio"
			android:visibility="gone"
			app:icon="@drawable/ic_audio_reacquire"
			app:iconSize="24dp" />

	</enk.danwills.android.enkishadereditor.widget.FlowLayout>

	<!-- Zero-size and invisible: exists only so ActionBarDrawerToggle has
	     a real Toolbar to drive (drawer-open back-press handling, etc.)
	     - see UIManager. The visible drawer button is drawer_toggle_btn
	     above, with its own plain static icon and click handling. -->
	<androidx.appcompat.widget.Toolbar
		android:id="@+id/toolbar"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="invisible" />
</LinearLayout>
