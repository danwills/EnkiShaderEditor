<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="24dp"
	android:paddingTop="8dp">

	<TextView
		android:id="@+id/record_sound_level_label"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textAppearance="?attr/textAppearanceBodyLarge"/>

	<SeekBar
		android:id="@+id/record_sound_level"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:max="100"/>

	<CheckBox
		android:id="@+id/record_voice"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="@string/record_screen_voice"/>

	<CheckBox
		android:id="@+id/record_duck"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/record_screen_duck"/>

	<!-- How far down, in dB: 3 + progress. -->
	<TextView
		android:id="@+id/record_duck_depth_label"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="32dp"
		android:textAppearance="?attr/textAppearanceBodyMedium"/>

	<SeekBar
		android:id="@+id/record_duck_depth"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="24dp"
		android:max="27"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="@string/record_screen_stop_hint"
		android:textAppearance="?attr/textAppearanceBodyMedium"/>
</LinearLayout>
